# ─────────────────────────────────────────────────────────────
# SIGA — Variables de entorno (ejemplo)
#
# Copiá este archivo a `.env.local` y completá con los valores
# reales de tu proyecto de Supabase. NUNCA subas `.env.local` al
# repositorio (está ignorado en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Supabase (público — seguro en el navegador) ──
# URL del proyecto. Ej: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anónima/publishable. Es pública por diseño: el acceso real
# queda restringido por las políticas Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Supabase (PRIVADO — SOLO en el servidor) ──
# Clave service_role / secret. Saltea RLS, por eso SOLO debe usarse
# en Route Handlers / código de servidor. Jamás exponerla al cliente
# ni prefijarla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── App ──
# URL base de la aplicación (redirects de auth, links de correo, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
